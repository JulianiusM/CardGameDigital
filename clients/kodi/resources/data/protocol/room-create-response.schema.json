{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "roomId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "roomCode": { "type": "string", "pattern": "^[A-Z2-9]{6}$" },
        "participantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "participantCredential": { "type": "string", "minLength": 32 },
        "role": { "type": "string", "enum": ["HOST", "PLAYER", "DISPLAY"] },
        "bootstrapMode": { "type": "string", "enum": ["CREATOR_HOST", "DISPLAY_WAITING_FOR_HOST"] },
        "hostStatus": {
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "enum": [
                        "AWAITING_FIRST_HOST",
                        "CONNECTING",
                        "CONNECTED",
                        "RECONNECTING",
                        "AWAITING_REPLACEMENT_HOST"
                    ]
                },
                "participantId": {
                    "anyOf": [
                        {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        { "type": "null" }
                    ]
                },
                "displayName": {
                    "anyOf": [
                        { "type": "string", "minLength": 1, "maxLength": 40 },
                        { "type": "null" }
                    ]
                },
                "deadline": {
                    "anyOf": [
                        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                        { "type": "null" }
                    ]
                }
            },
            "required": ["state", "participantId", "displayName", "deadline"],
            "additionalProperties": false
        }
    },
    "required": [
        "roomId",
        "roomCode",
        "participantId",
        "participantCredential",
        "role",
        "bootstrapMode",
        "hostStatus"
    ],
    "additionalProperties": false
}
