{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "protocol": { "type": "number", "const": 2 },
        "type": { "type": "string", "const": "client.ping" },
        "requestId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "revision": { "type": "null" },
        "payload": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    "required": ["protocol", "type", "requestId", "revision", "payload"],
    "additionalProperties": false
}
