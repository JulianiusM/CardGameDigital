{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "protocol": { "type": "number", "const": 4 },
        "type": { "type": "string", "const": "client.hello" },
        "requestId": {
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }]
        },
        "revision": { "type": "null" },
        "payload": {
            "type": "object",
            "properties": {
                "supportedProtocolVersions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                    }
                },
                "applicationVersion": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "enum": ["HOST", "PLAYER", "DISPLAY"] },
                "capabilities": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "JOIN_ROOM",
                            "DISPLAY_SESSION",
                            "START_SESSION",
                            "CHOOSE_CARD_TYPE",
                            "SUBMIT_VOTE",
                            "SKIP_CARD",
                            "ADVANCE_SESSION",
                            "VETO_CARD",
                            "CHANGE_SESSION_SETTINGS",
                            "MANAGE_PLAYERS",
                            "MANAGE_DEVICE_PLAYERS",
                            "TRANSFER_HOST",
                            "END_SESSION",
                            "LEAVE_ROOM"
                        ]
                    }
                },
                "roomCode": { "type": "string", "pattern": "^[A-Z2-9]{6}$" },
                "participantCredential": { "type": "string", "minLength": 32 }
            },
            "required": [
                "supportedProtocolVersions",
                "applicationVersion",
                "role",
                "capabilities",
                "roomCode",
                "participantCredential"
            ],
            "additionalProperties": false
        }
    },
    "required": ["protocol", "type", "requestId", "revision", "payload"],
    "additionalProperties": false
}
