{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "protocol": { "type": "number", "const": 2 },
        "type": { "type": "string", "const": "room.presence" },
        "requestId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "revision": { "type": "null" },
        "payload": {
            "type": "object",
            "properties": {
                "connected": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "participantId": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                            },
                            "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
                            "role": { "type": "string", "enum": ["HOST", "PLAYER", "DISPLAY"] }
                        },
                        "required": ["participantId", "displayName", "role"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["connected"],
            "additionalProperties": false
        }
    },
    "required": ["protocol", "type", "requestId", "revision", "payload"],
    "additionalProperties": false
}
