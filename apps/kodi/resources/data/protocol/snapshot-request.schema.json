{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "protocol": { "type": "number", "const": 4 },
        "type": { "type": "string", "const": "room.snapshot.request" },
        "requestId": {
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }]
        },
        "revision": {
            "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                { "type": "null" }
            ]
        },
        "payload": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    "required": ["protocol", "type", "requestId", "revision", "payload"],
    "additionalProperties": false
}
