{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "protocol": { "type": "number", "const": 4 },
        "type": { "type": "string", "const": "room.roleChanged" },
        "requestId": {
            "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }]
        },
        "revision": { "type": "null" },
        "payload": {
            "type": "object",
            "properties": {
                "role": { "type": "string", "enum": ["HOST", "PLAYER", "DISPLAY"] },
                "previousRole": { "type": "string", "enum": ["HOST", "PLAYER", "DISPLAY"] },
                "reason": {
                    "type": "string",
                    "enum": [
                        "INITIAL_HOST_ASSIGNED",
                        "HOST_TRANSFERRED",
                        "HOST_LEFT",
                        "HOST_DISCONNECT_EXPIRED",
                        "HOST_REVOKED",
                        "HOST_ACTIVATION_EXPIRED"
                    ]
                }
            },
            "required": ["role", "previousRole", "reason"],
            "additionalProperties": false
        }
    },
    "required": ["protocol", "type", "requestId", "revision", "payload"],
    "additionalProperties": false
}
