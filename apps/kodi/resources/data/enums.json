{
    "schemaVersion": 1,
    "protocolVersion": 4,
    "constraints": {
        "maximumWebSocketMessageBytes": 4194304,
        "maximumRequestIdCharacters": 128,
        "maximumRoomParticipants": 1000,
        "maximumRoomPlayers": 1000,
        "roomCodePattern": "^[A-Z2-9]{6}$",
        "roomGameSettings": {
            "intensityProgressionInterval": { "minimum": 1, "maximum": 100 },
            "intensityProgressionIncrement": { "minimum": 0.5, "maximum": 4, "step": 0.5 },
            "randomQuestionRatio": { "minimum": 0, "maximum": 1 },
            "maximumTypeStreak": { "minimum": 1, "maximum": 10 },
            "letsTalkMetaInterval": { "minimum": 1, "maximum": 100 }
        }
    },
    "clientRoles": ["HOST", "PLAYER", "DISPLAY"],
    "clientCapabilities": [
        "JOIN_ROOM",
        "DISPLAY_SESSION",
        "START_SESSION",
        "CHOOSE_CARD_TYPE",
        "SUBMIT_VOTE",
        "SKIP_CARD",
        "ADVANCE_SESSION",
        "VETO_CARD",
        "CHANGE_SESSION_SETTINGS",
        "MANAGE_PLAYERS",
        "MANAGE_DEVICE_PLAYERS",
        "TRANSFER_HOST",
        "END_SESSION",
        "LEAVE_ROOM"
    ],
    "roomBootstrapModes": ["CREATOR_HOST", "DISPLAY_WAITING_FOR_HOST"],
    "roomHostStates": [
        "AWAITING_FIRST_HOST",
        "CONNECTING",
        "CONNECTED",
        "RECONNECTING",
        "AWAITING_REPLACEMENT_HOST"
    ],
    "roomRoleChangeReasons": [
        "INITIAL_HOST_ASSIGNED",
        "HOST_TRANSFERRED",
        "HOST_LEFT",
        "HOST_DISCONNECT_EXPIRED",
        "HOST_REVOKED",
        "HOST_ACTIVATION_EXPIRED"
    ],
    "cardLifecycles": ["ACTIVE", "RETIRED"],
    "sessionPersistenceModes": ["EPHEMERAL", "DATASPACE"],
    "neverHaveIEverVoteStatuses": ["PENDING", "VOTED"],
    "neverHaveIEverVoteValues": ["YES", "NO"],
    "participantLeftReasons": ["LEFT", "DISCONNECT_EXPIRED"],
    "cardReplacementReasons": ["SKIPPED", "VETOED"],
    "participantConnectionStatuses": ["CONNECTED", "TEMPORARILY_DISCONNECTED"],
    "protocolErrorCodes": [
        "VALIDATION_ERROR",
        "AUTHENTICATION_ERROR",
        "ROOM_NOT_FOUND",
        "ROOM_FULL",
        "ROOM_BOOTSTRAP_MODE_UNSUPPORTED",
        "IDEMPOTENCY_KEY_REQUIRED",
        "IDEMPOTENCY_KEY_INVALID",
        "IDEMPOTENCY_KEY_REUSED",
        "IDEMPOTENCY_REQUEST_IN_PROGRESS",
        "IDEMPOTENCY_RESULT_GONE",
        "CARD_LOCALE_UNAVAILABLE",
        "INVALID_GAME_STATE",
        "NOT_ACTIVE_PLAYER",
        "CARD_POOL_EXHAUSTED",
        "SESSION_CAPACITY_EXCEEDED",
        "STALE_SESSION_REVISION",
        "NOT_AUTHORIZED",
        "PROTOCOL_VERSION_UNSUPPORTED"
    ],
    "cardTypes": ["QUESTION", "DARE", "CONVERSATION_META"],
    "intensityLevels": [1, 2, 3, 4, 5],
    "gameModes": [
        "CLASSIC_TRUTH_OR_DARE",
        "RANDOM_TRUTH_OR_DARE",
        "NEVER_HAVE_I_EVER",
        "LETS_TALK"
    ],
    "sessionStates": [
        "WAITING_FOR_PLAYER",
        "CHOOSING_CARD_TYPE",
        "SELECTING_CARD",
        "SHOWING_CARD",
        "WAITING_FOR_RESOLUTION",
        "COLLECTING_ANSWERS",
        "SHOWING_RESULTS",
        "TRANSITION",
        "NEXT_PLAYER",
        "ENDED"
    ],
    "intensityProgressionUnits": ["ROUNDS", "CARDS"],
    "neverHaveIEverRevealModes": ["ANONYMOUS_AGGREGATE", "NAMED_ANSWERS"],
    "availabilityDirectives": ["INHERIT", "INCLUDE", "EXCLUDE"],
    "booleanDirectives": ["INHERIT", "ENABLE", "DISABLE"],
    "scalarDirectiveModes": ["INHERIT", "CATALOG", "SET"],
    "questionCategoryIds": [
        "CAT_EVERYDAY",
        "CAT_CHILDHOOD",
        "CAT_PERSONALITY",
        "CAT_SCENARIO",
        "CAT_INTOXICATION",
        "CAT_FRIENDSHIP",
        "CAT_RELATIONSHIP",
        "CAT_BODY",
        "CAT_SEXUALITY",
        "CAT_SEX_OPENNESS",
        "CAT_SEX_TENSION",
        "CAT_SEX_EXPERIENCE"
    ],
    "dareTypeIds": [
        "DARE_SILLY",
        "DARE_THIRD_PARTY",
        "DARE_KISS",
        "DARE_KISS_SPICY",
        "DARE_TOUCH",
        "DARE_TOUCH_SPICY",
        "DARE_TOUCH_SEXY",
        "DARE_CLOTHING",
        "DARE_NUDITY",
        "DARE_SEXUAL_TENSION",
        "DARE_BORDERLINE_SEX",
        "DARE_SEX",
        "DARE_OTHER"
    ],
    "operationalFlags": [
        "REQUIRES_TARGET_PLAYER",
        "INVOLVES_THIRD_PARTY",
        "REQUIRES_PHYSICAL_CONTACT",
        "REMOVES_CLOTHING",
        "REQUIRES_NUDITY",
        "INVOLVES_ALCOHOL",
        "INVOLVES_RECREATIONAL_SUBSTANCES"
    ],
    "socialSensitivities": [
        "GENERAL",
        "PERSONAL",
        "CLOSE_PERSONAL",
        "DEEP_PERSONAL",
        "INTIMATE",
        "EXPLICIT"
    ]
}
