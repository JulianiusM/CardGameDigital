{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "isolatedModules": true,
        "lib": ["ES2022", "DOM"],
        "types": ["svelte"]
    },
    "include": ["src/**/*.ts", "src/**/*.svelte"]
}
