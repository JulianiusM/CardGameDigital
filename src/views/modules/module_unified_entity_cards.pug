//- Unified entity overview (card-based)
//- Args:
//-   id            : string
//-   title         : string
//-   iconHeader    : string
//-   items         : Entity[]
//-   emptyText     : string
//-   parent        : string
//-   showCreate    : boolean

mixin entityOverview(id, title, iconHeader, items, emptyText, parent, showCreate)

    - const _count = (items && items.length) || 0;
    - const _types = [...new Set(items.map(item => item.type))];

    .accordion-item
        h2.accordion-header
            button.accordion-button(
                type="button"
                data-bs-toggle="collapse"
                data-bs-target=`#${id}`
                aria-expanded="true"
                aria-controls=id
            )
                i(class=`bi ${iconHeader} me-2`)
                | #{title}
                span.badge.bg-secondary.ms-2.js-count #{_count}

        .accordion-collapse.collapse.show(id=id data-bs-parent=`#${parent}`)
            .accordion-body

                // Toolbar
                .d-flex.flex-wrap.gap-2.mb-3.align-items-center

                    // Search
                    .input-group.input-group-sm(style="max-width: 320px;")
                        span.input-group-text
                            i.bi.bi-search
                        input.form-control.js-search(
                            type="search"
                            placeholder=`Search ${title.toLowerCase()}…`
                        )

                    // Type filter
                    .dropdown
                        button.btn.btn-outline-secondary.btn-sm.dropdown-toggle(
                            type="button"
                            data-bs-toggle="dropdown"
                        )
                            | Filter
                        ul.dropdown-menu.js-filter-type
                            li
                                button.dropdown-item(data-type="all") All types
                            li
                                hr.dropdown-divider
                            each item in _types
                                li
                                    button.dropdown-item(data-type=item)
                                        | #{item}

                if _count

                    // Responsive Bootstrap grid
                    .row.row-cols-1.row-cols-sm-2.row-cols-md-3.row-cols-lg-4.g-4
                        each item in items
                            .col
                                .card.h-100.bg-secondary-subtle.border-secondary.js-item(
                                    data-title=item.title
                                    data-type=item.type
                                    data-description=item.description || ''
                                    data-owner=item.ownerId
                                    data-event=item.eventId || ''
                                )

                                    if item.imageUrl
                                        a(href=item.url)
                                            img.card-img-top(
                                                src=item.imageUrl
                                                alt=item.title
                                                style="object-fit: cover; height: 200px;"
                                            )

                                    a.card-body.text-decoration-none(href=item.url)
                                        h4.card-title.mb-1
                                            | #{item.title}
                                        if item.description
                                            p.card-text.small.mb-2.text-truncate(style="max-width: 100%;")
                                                | #{item.description}

                                    .card-footer
                                        span.badge.bg-primary
                                            | #{item.type}
                                        if showCreate && item.ownerId === profile.id
                                            form.d-inline.btn-group.float-end(method="post" action=`${item.url}/delete` onsubmit="return confirm('Delete this item?');")
                                                a.btn.btn-sm.btn-info(href=`${item.url}/duplicate`)
                                                    i.bi.bi-files.me-1
                                                    | Duplicate
                                                button.btn.btn-sm.btn-danger(type="submit")
                                                    i.bi.bi-trash.me-1
                                                    | Delete

                else
                    .alert.alert-info.mb-0
                        i.bi.bi-info-circle.me-2
                        | #{emptyText}