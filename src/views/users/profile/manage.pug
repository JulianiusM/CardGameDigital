extends ../../layout

block meta
    title Manage profiles | Surveyor

block title
    h1.card-header.text-center
        i.bi.bi-archive-fill.me-2
        | Manage your profiles

block content
    ul.list-group
        each profile in data.profiles
            li.list-group-item.d-flex.justify-content-between.align-items-start
                .ms-2.me-auto.my-auto #{profile.name}
                a.btn.btn-primary(href=`/users/profile/change/${profile.id}`)
                    i.bi.bi-arrow-left-right.me-1
                    | Switch to profile

    .mt-2.row.justify-content-center
        .col-md-4.d-grid.text-center.mt-3
            a.btn.btn-primary(href="/users/dashboard")
                i.bi.bi-arrow-left-circle.me-1
                | Back to home
        .col-md-4.d-grid.text-center.mt-3
            a.btn.btn-secondary(href="/users/profile/migrate/show")
                i.bi.bi-archive.me-1
                | Migrate profile to account
        .col-md-4.d-grid.text-center.mt-3
            a.btn.btn-success(href="/users/profile/create")
                i.bi.bi-plus-circle.me-1
                | Create new profile