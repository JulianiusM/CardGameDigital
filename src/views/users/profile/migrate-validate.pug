extends ../../layout

block meta
    title Migrate Profile | Surveyor

block title
    h1.card-header.text-center
        i.bi.bi-archive-fill.me-2
        | Migrate profile to your user

block content
    p.lead.text-center Look at the profile to migrate below. When you are ready, confirm migration to proceed.
    p.text-center Warning: If this is the last profile on the original account, it will be automatically deleted after migration is successful.

    .row.gy-3.justify-content-center
        .col-md-6
            h4 Name
            p #{data.profile.name}

        .col-md-6
            h4 ID
            p #{data.profile.id}

        .col-md-6
            h4 Current Owner
            if data.profile.user
                p #{data.profile.user.name} (#{data.profile.user.username} | #{data.profile.user.email})
            else if data.profile.guest
                p #{data.profile.guest.username} (#{data.profile.guest.email || '-'})
            else
                p No current owner (deactivated profile)

        .col-md-6

    form#forgotForm.row.gy-3.justify-content-center(
        action="/users/profile/migrate/execute"
        method="post")
        .col-md-6
            input#token.form-control.text-bg-dark(
                type="text"
                name="token"
                placeholder="Your migration token"
                value = data.profile.migrationToken
                hidden)

        //── Submit ──────────────────────────────────────────────
        .col-12.d-grid.mt-2
            button.btn.btn-warning(type="submit")
                i.bi.bi-exclamation-triangle.me-1
                | Permanently migrate profile

        //── Zurück zum Login ───────────────────────────────────
        .col-12.text-center.mt-3
            a.text-decoration-none(href="/users/profile/manage")
                i.bi.bi-arrow-left-circle.me-1
                | Back to home