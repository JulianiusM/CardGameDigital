extends ../../layout

block meta
    title Deactivate Profile | Surveyor

block title
    h1.card-header.text-center
        i.bi.bi-trash-fill.me-2
        | Deactivate your profile?

block content
    p.lead.text-center.mb-4
        i.bi.bi-exclamation-diamond-fill.me-1
        | Enter your profile name to confirm deleting your account. This action is permanent and cannot be undone!

    form#forgotForm.row.gy-3.justify-content-center(
        action="/users/profile/delete"
        method="post")
        //── Username ────────────────────────────────────────────
        .col-md-6
            label.form-label.mb-1(for="name")
                i.bi.bi-person-circle.me-1
                | Profile name *
            input#name.form-control.text-bg-dark(
                type="text"
                name="name"
                placeholder="Your profile name"
                value = data ? data.name : ""
                required)

        //── Submit ──────────────────────────────────────────────
        .col-12.d-grid.mt-2
            button.btn.btn-danger(type="submit")
                i.bi.bi-trash.me-1
                | Permanently deactivate profile

        //── Zurück zum Login ───────────────────────────────────
        .col-12.text-center.mt-3
            a.text-decoration-none(href="/users/profile")
                i.bi.bi-arrow-left-circle.me-1
                | Back to home
