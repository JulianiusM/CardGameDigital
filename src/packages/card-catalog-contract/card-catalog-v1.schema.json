{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://cardgame.example/contracts/game-card-catalog-v1.schema.json",
    "title": "game-card-catalog/v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contract",
        "catalogId",
        "sequence",
        "catalogVersion",
        "generatedAt",
        "defaultLocale",
        "locales",
        "questionCategories",
        "dareTypes",
        "cards"
    ],
    "properties": {
        "contract": { "const": "game-card-catalog/v1" },
        "catalogId": { "type": "string", "minLength": 1, "maxLength": 40 },
        "sequence": { "type": "integer", "minimum": 1 },
        "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "defaultLocale": { "$ref": "#/$defs/localeId" },
        "locales": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "nativeName", "active"],
                "properties": {
                    "id": { "$ref": "#/$defs/localeId" },
                    "nativeName": { "$ref": "#/$defs/shortText" },
                    "active": { "type": "boolean" }
                }
            }
        },
        "questionCategories": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "localizations"],
                "properties": {
                    "id": {
                        "enum": [
                            "CAT_EVERYDAY",
                            "CAT_CHILDHOOD",
                            "CAT_PERSONALITY",
                            "CAT_SCENARIO",
                            "CAT_INTOXICATION",
                            "CAT_FRIENDSHIP",
                            "CAT_RELATIONSHIP",
                            "CAT_BODY",
                            "CAT_SEXUALITY",
                            "CAT_SEX_OPENNESS",
                            "CAT_SEX_TENSION",
                            "CAT_SEX_EXPERIENCE"
                        ]
                    },
                    "localizations": {
                        "type": "array",
                        "items": { "$ref": "#/$defs/taxonomyLocalization" }
                    }
                }
            }
        },
        "dareTypes": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "localizations"],
                "properties": {
                    "id": {
                        "enum": [
                            "DARE_SILLY",
                            "DARE_THIRD_PARTY",
                            "DARE_KISS",
                            "DARE_KISS_SPICY",
                            "DARE_TOUCH",
                            "DARE_TOUCH_SPICY",
                            "DARE_TOUCH_SEXY",
                            "DARE_CLOTHING",
                            "DARE_NUDITY",
                            "DARE_SEXUAL_TENSION",
                            "DARE_BORDERLINE_SEX",
                            "DARE_SEX",
                            "DARE_OTHER"
                        ]
                    },
                    "localizations": {
                        "type": "array",
                        "items": { "$ref": "#/$defs/taxonomyLocalization" }
                    }
                }
            }
        },
        "cards": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "lifecycle",
                    "cardType",
                    "yesNoAnswerPossible",
                    "questionCategoryId",
                    "dareTypeId",
                    "dareAffinityCategoryId",
                    "intensity",
                    "alwaysEligible",
                    "repeatableInSession",
                    "repeatCooldown",
                    "weight",
                    "operationalFlags",
                    "localizations"
                ],
                "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "lifecycle": { "enum": ["ACTIVE", "RETIRED"] },
                    "cardType": { "enum": ["QUESTION", "DARE", "CONVERSATION"] },
                    "yesNoAnswerPossible": { "type": "boolean" },
                    "questionCategoryId": {
                        "oneOf": [{ "$ref": "#/$defs/questionCategory" }, { "type": "null" }]
                    },
                    "dareTypeId": { "oneOf": [{ "$ref": "#/$defs/dareType" }, { "type": "null" }] },
                    "dareAffinityCategoryId": {
                        "oneOf": [{ "$ref": "#/$defs/questionCategory" }, { "type": "null" }]
                    },
                    "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "alwaysEligible": { "type": "boolean" },
                    "repeatableInSession": { "type": "boolean" },
                    "repeatCooldown": { "type": "integer", "minimum": 0 },
                    "weight": { "type": "number", "exclusiveMinimum": 0 },
                    "operationalFlags": {
                        "type": "array",
                        "items": {
                            "enum": [
                                "REQUIRES_TARGET_PLAYER",
                                "INVOLVES_THIRD_PARTY",
                                "REQUIRES_PHYSICAL_CONTACT",
                                "REQUIRES_PRIVATE_SPACE",
                                "REMOVES_CLOTHING",
                                "REQUIRES_NUDITY",
                                "INVOLVES_ALCOHOL",
                                "INVOLVES_RECREATIONAL_DRUGS"
                            ]
                        }
                    },
                    "localizations": {
                        "type": "array",
                        "items": { "$ref": "#/$defs/cardLocalization" }
                    }
                }
            }
        }
    },
    "$defs": {
        "localeId": { "type": "string", "minLength": 2, "maxLength": 35 },
        "shortText": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cardLocalization": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locale", "text"],
            "properties": {
                "locale": { "$ref": "#/$defs/localeId" },
                "text": { "type": "string", "minLength": 1 }
            }
        },
        "taxonomyLocalization": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locale", "label"],
            "properties": {
                "locale": { "$ref": "#/$defs/localeId" },
                "label": { "$ref": "#/$defs/shortText" },
                "description": {
                    "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                }
            }
        },
        "questionCategory": {
            "enum": [
                "CAT_EVERYDAY",
                "CAT_CHILDHOOD",
                "CAT_PERSONALITY",
                "CAT_SCENARIO",
                "CAT_INTOXICATION",
                "CAT_FRIENDSHIP",
                "CAT_RELATIONSHIP",
                "CAT_BODY",
                "CAT_SEXUALITY",
                "CAT_SEX_OPENNESS",
                "CAT_SEX_TENSION",
                "CAT_SEX_EXPERIENCE"
            ]
        },
        "dareType": {
            "enum": [
                "DARE_SILLY",
                "DARE_THIRD_PARTY",
                "DARE_KISS",
                "DARE_KISS_SPICY",
                "DARE_TOUCH",
                "DARE_TOUCH_SPICY",
                "DARE_TOUCH_SEXY",
                "DARE_CLOTHING",
                "DARE_NUDITY",
                "DARE_SEXUAL_TENSION",
                "DARE_BORDERLINE_SEX",
                "DARE_SEX",
                "DARE_OTHER"
            ]
        }
    }
}
