{
    "name": "multiplayer-party-card-game",
    "version": "0.0.1-rc.0",
    "private": true,
    "license": "Apache-2.0",
    "scripts": {
        "pretest": "npm run generate:check",
        "pretest:integration": "npm run generate:check",
        "pretest:ci": "npm run generate:check",
        "run": "node dist/apps/server/src/server.js",
        "server:dev": "nodemon --watch apps/server/src --watch apps/server/migrations --watch packages --ext ts,js --exec \"ts-node --project tsconfig.server.json apps/server/src/server.ts\"",
        "server": "npm run build && npm run server:dev",
        "serve": "npm run build && npm run run",
        "typeorm": "ts-node --project tsconfig.server.json tooling/database/runMigration.ts",
        "typeorm:drop": "npm run typeorm -- schema:drop apps/server/migrationDataSource.ts",
        "typeorm:sync": "npm run typeorm -- schema:sync apps/server/migrationDataSource.ts",
        "typeorm:migrate": "npm run typeorm -- migration:run apps/server/migrationDataSource.ts",
        "typeorm:reset-db": "npm run generate:db-index && npm run typeorm:drop && npm run typeorm:sync && npm run typeorm:migrate",
        "installation:reset": "ts-node --project tsconfig.server.json tooling/database/resetInstallationIdentity.ts",
        "generate:db-index": "ts-node --project tsconfig.server.json tooling/database/generateIndex.ts",
        "generate:db-index:check": "ts-node --project tsconfig.server.json tooling/database/generateIndex.ts --check",
        "generate:web-tokens": "ts-node --project tsconfig.server.json tooling/design/generateWebTokens.ts",
        "generate:web-tokens:check": "ts-node --project tsconfig.server.json tooling/design/generateWebTokens.ts --check",
        "generate": "npm run generate:db-index && npm run generate:web-tokens && npm run kodi:generate",
        "generate:check": "npm run generate:db-index:check && npm run generate:web-tokens:check && npm run kodi:generate:check",
        "kodi:generate": "ts-node --project tsconfig.server.json tooling/kodi/generateLocalization.ts && ts-node --project tsconfig.server.json tooling/kodi/generateArtifacts.ts",
        "kodi:generate:check": "ts-node --project tsconfig.server.json tooling/kodi/generateLocalization.ts --check && ts-node --project tsconfig.server.json tooling/kodi/generateArtifacts.ts --check",
        "kodi:lint": "python -B apps/kodi/tools/check.py",
        "kodi:test": "python -B -m unittest discover -s apps/kodi/tests -p \"test_*.py\"",
        "kodi:check": "npm run kodi:generate:check && npm run kodi:lint && npm run kodi:test",
        "kodi:package": "npm run kodi:check && ts-node --project tsconfig.server.json tooling/kodi/release.ts package",
        "kodi:package:verify": "ts-node --project tsconfig.server.json tooling/kodi/release.ts verify",
        "card:catalog:validate": "ts-node --project tsconfig.server.json tooling/catalog/cli.ts",
        "copy": "npm run copy:docs && npm run copy:catalog",
        "build:server": "npm run card:catalog:validate && npm run generate && tsc --project tsconfig.server.json",
        "typecheck:web": "svelte-check --tsconfig apps/web/tsconfig.json",
        "build:web": "npm run typecheck:web && vite build --config apps/web/vite.config.mts",
        "build:server-web": "npm run build:server && npm run build:web && npm run copy",
        "build": "npm run build:server-web",
        "package:server-web": "npm run build:server-web && ts-node --project tsconfig.server.json tooling/release/package.ts portable && ts-node --project tsconfig.server.json tooling/release/package.ts public",
        "package:server-web:portable": "npm run build:server-web && ts-node --project tsconfig.server.json tooling/release/package.ts portable",
        "package:server-web:public": "npm run build:server-web && ts-node --project tsconfig.server.json tooling/release/package.ts public",
        "package:server-web:smoke": "ts-node --project tsconfig.server.json tooling/release/smoke.ts",
        "test": "vitest run",
        "benchmark:operations": "ts-node --project tsconfig.server.json tooling/testing/operationalBudgets.ts",
        "test:quick": "vitest run tests/unit tests/architecture",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:mariadb:reset": "ts-node --project tsconfig.server.json tooling/database/resetMariaTestDatabases.ts",
        "test:mariadb:public": "vitest run tests/integration/public-mode-mariadb.spec.ts",
        "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
        "e2e:prepare": "ts-node --project tsconfig.server.json tooling/testing/e2eDatabaseInit.ts",
        "e2e:init": "npm run e2e:prepare && npm run run",
        "e2e": "playwright test",
        "e2e:couch:init": "ts-node --project tsconfig.server.json tooling/testing/e2eCouchInit.ts",
        "e2e:couch": "playwright test --config playwright.couch.config.ts",
        "e2e:visual": "playwright test --config playwright.visual.config.ts",
        "test:all": "npm test && npm run build && npm run e2e",
        "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=artifacts/junit-vitest.xml",
        "format": "prettier --write \"apps/web/**/*.{ts,js,svelte,css,json,html,mts}\" \"apps/server/**/*.ts\" \"packages/**/*.{ts,json}\" \"tooling/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"README.md\" \"AGENTS.md\" \"vitest.config.mts\" \"playwright.config.ts\" \"playwright.couch.config.ts\" \"playwright.visual.config.ts\" \"package.json\" \".prettierrc.json\"",
        "format:check": "prettier --check \"apps/web/**/*.{ts,js,svelte,css,json,html,mts}\" \"apps/server/**/*.ts\" \"packages/**/*.{ts,json}\" \"tooling/**/*.ts\" \"tests/**/*.ts\" \"apps/kodi/**/*.{json,md}\" \"docs/**/*.md\" \"README.md\" \"AGENTS.md\" \"vitest.config.mts\" \"playwright.config.ts\" \"playwright.couch.config.ts\" \"playwright.visual.config.ts\" \"package.json\" \".prettierrc.json\" && npm run kodi:lint",
        "copy:docs": "cpx \"docs/user-guide/**/*\" dist/docs/user-guide --clean",
        "copy:catalog": "cpx \"catalog/card-catalog.json\" dist/catalog"
    },
    "engines": {
        "node": ">=24.7.0 <25.0.0"
    },
    "overrides": {
        "connect-typeorm": {
            "typeorm": "^1.1.0"
        }
    },
    "dependencies": {
        "@homebridge/ciao": "^1.3.4",
        "better-sqlite3": "^12.11.1",
        "connect-typeorm": "^2.0.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "express-session": "^1.19.0",
        "marked": "^18.0.10",
        "mysql2": "^3.23.4",
        "nodemailer": "^9.0.5",
        "openid-client": "^6.8.7",
        "qrcode": "^1.5.4",
        "typeorm": "^1.1.0",
        "uuid": "^14.0.2",
        "ws": "^8.21.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/node": "^26.2.0",
        "@types/nodemailer": "^8.0.1",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^7.2.1",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^4.1.11",
        "cpx2": "^9.0.0",
        "nodemon": "^3.1.14",
        "postject": "1.0.0-alpha.6",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "supertest": "^7.2.2",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
