{
  "name": "surveyor",
  "version": "0.2.3-rc.2",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "pretest": "npm run generate",
    "pretest:integration": "npm run generate",
    "pretest:ci": "npm run generate",
    "run": "node dist/server.js",
    "server:dev": "nodemon --watch src --ext ts,js --exec \"ts-node --project tsconfig.server.json src/server.ts\"",
    "server:client": "cross-env NODE_ENV=development node esbuild.client.js --watch",
    "server": "npm run build && concurrently \"npm run server:dev\" \"npm run server:client\"",
    "typeorm": "ts-node --project tsconfig.server.json scripts/runMigration.ts",
    "typeorm:drop": "npm run typeorm -- schema:drop migrationDataSource.ts",
    "typeorm:sync": "npm run typeorm -- schema:sync migrationDataSource.ts",
    "typeorm:migrate": "npm run typeorm -- migration:run migrationDataSource.ts",
    "typeorm:reset-db": "npm run generate:db-index && npm run typeorm:drop && npm run typeorm:sync && npm run typeorm:migrate",
    "generate:db-index": "ts-node --project tsconfig.server.json scripts/genTypeormIdx.ts",
    "generate": "npm run generate:db-index",
    "copy:assets": "cpx \"src/public/{img,style}/**/*\" dist/public",
    "copy:views": "cpx \"src/views/**/*\" dist/views",
    "copy": "npm run copy:assets && npm run copy:views",
    "build:sass": "sass src/public/style:src/public/style --no-source-map",
    "build:server": "npm run generate && tsc --project tsconfig.server.json",
    "build:client": "cross-env NODE_ENV=production node esbuild.client.js",
    "build": "npm run build:sass && npm run build:server && npm run build:client && npm run copy",
    "test": "vitest run",
    "test:quick": "vitest run tests/unit tests/frontend",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:frontend": "vitest run tests/frontend",
    "e2e:prepare": "ts-node --project tsconfig.server.json scripts/e2e.db.init.ts",
    "e2e:init": "npm run e2e:prepare && npm run run",
    "e2e": "playwright test",
    "test:all": "npm test && npm run build && npm run e2e",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=artifacts/junit-vitest.xml"
  },
  "overrides": {
    "connect-typeorm": {
      "typeorm": "^1.1.0"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "connect-typeorm": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "csv-reader": "^1.0.12",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-flash": "^0.0.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "http-errors": "^2.0.1",
    "joi": "^18.2.3",
    "marked": "^18.0.9",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.4",
    "openid-client": "^6.8.4",
    "pdfmake": "^0.3.11",
    "pug": "^3.0.4",
    "typeorm": "^1.1.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-flash": "^0.0.5",
    "@types/express-session": "^1.19.0",
    "@types/jquery": "^4.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/select2": "^4.0.63",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "cpx2": "^9.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "jquery": "^4.0.0",
    "nodemon": "^3.1.14",
    "sass": "^1.102.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
