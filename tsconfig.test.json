{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "types": ["@playwright/test", "node"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.d.ts"]
}
