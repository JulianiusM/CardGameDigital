{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "types": ["@playwright/test", "node"]
    },
    "include": [
        "apps/server/src/**/*.ts",
        "apps/server/migrations/**/*.ts",
        "packages/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.d.ts"
    ]
}
